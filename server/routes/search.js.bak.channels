import express from "express";
import User from "../models/User.js";
import Post from "../models/Post.js";
import Job from "../models/Job.js";
import { protect } from "../middleware/auth.js";

const router = express.Router();

// Escape regex special chars
function escapeRegex(str) {
  return String(str).replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
}

// Build a "word-boundary aware" regex — matches "joel" in "Joel Mutauri"
// but also "software engineer" against "Senior Software Engineer"
function buildWordRegex(query) {
  const words = String(query).trim().split(/\s+/).filter(Boolean).slice(0, 6);
  const escaped = words.map(escapeRegex);
  if (escaped.length === 0) return null;
  // Match any word, case-insensitive
  return new RegExp(escaped.join("|"), "i");
}

// Score a text field against a query — returns 0-100
function scoreField(value, query) {
  if (!value || !query) return 0;
  const v = String(value).toLowerCase();
  const q = String(query).toLowerCase().trim();
  if (!q) return 0;

  // Exact full match
  if (v === q) return 100;
  // Starts with query (higher priority for names)
  if (v.startsWith(q)) return 90;
  // Query is a word inside the value
  const wordBoundary = new RegExp("(^|\\s)" + escapeRegex(q), "i");
  if (wordBoundary.test(v)) return 80;
  // Substring match
  if (v.includes(q)) return 60;
  // Multi-word: any word matches
  const words = q.split(/\s+/);
  const anyMatch = words.some((w) => w.length >= 2 && v.includes(w));
  if (anyMatch) return 40;
  return 0;
}

// GET /api/search?q=...&type=all|people|jobs|companies|posts|channels
router.get("/", protect, async (req, res) => {
  try {
    const q = String(req.query.q || "").trim().slice(0, 80);
    const type = String(req.query.type || "all").toLowerCase();
    if (!q) {
      return res.json({ people: [], jobs: [], companies: [], posts: [], channels: [] });
    }

    const wordRx = buildWordRegex(q);
    if (!wordRx) return res.json({ people: [], jobs: [], companies: [], posts: [], channels: [] });

    const limit = 25;
    const wantsPeople = type === "all" || type === "people";
    const wantsJobs = type === "all" || type === "jobs";
    const wantsCompanies = type === "all" || type === "companies";
    const wantsPosts = type === "all" || type === "posts";

    const [people, companies, jobs, posts] = await Promise.all([
      wantsPeople
        ? User.find({
            accountType: "jobseeker",
            $or: [
              { name: wordRx },
              { headline: wordRx },
              { category: wordRx },
              { location: wordRx },
              { skills: wordRx },
              { about: wordRx },
            ],
          })
            .select("name profilePicture profilePicLocked headline category location accountType skills")
            .limit(limit * 2)
            .lean()
        : Promise.resolve([]),

      wantsCompanies
        ? User.find({
            accountType: "company",
            $or: [
              { companyName: wordRx },
              { name: wordRx },
              { category: wordRx },
              { location: wordRx },
              { about: wordRx },
            ],
          })
            .select("name companyName profilePicture headline category location accountType")
            .limit(limit * 2)
            .lean()
        : Promise.resolve([]),

      wantsJobs
        ? Job.find({
            deleted: false,
            $or: [
              { title: wordRx },
              { company: wordRx },
              { location: wordRx },
              { category: wordRx },
              { description: wordRx },
            ],
          })
            .sort({ createdAt: -1 })
            .limit(limit * 2)
            .lean()
        : Promise.resolve([]),

      wantsPosts
        ? Post.find({
            deleted: false,
            $or: [{ visibility: "public" }, { visibility: { $exists: false } }],
            text: wordRx,
          })
            .sort({ createdAt: -1 })
            .limit(limit * 2)
            .populate("author", "name profilePicture profilePicLocked headline category accountType")
            .lean()
        : Promise.resolve([]),
    ]);

    // ── RANK by relevance ──
    const rankedPeople = people
      .map((p) => {
        const s = Math.max(
          scoreField(p.name, q),
          scoreField(p.headline, q) * 0.7,
          scoreField(p.category, q) * 0.6,
          scoreField(p.location, q) * 0.5,
          scoreField((p.skills || []).join(" "), q) * 0.6
        );
        return { ...p, _score: s };
      })
      .sort((a, b) => b._score - a._score)
      .slice(0, limit);

    const rankedCompanies = companies
      .map((c) => {
        const s = Math.max(
          scoreField(c.companyName || c.name, q),
          scoreField(c.category, q) * 0.7,
          scoreField(c.location, q) * 0.5
        );
        return { ...c, _score: s, name: c.companyName || c.name };
      })
      .sort((a, b) => b._score - a._score)
      .slice(0, limit);

    const rankedJobs = jobs
      .map((j) => {
        const s = Math.max(
          scoreField(j.title, q),
          scoreField(j.company, q) * 0.7,
          scoreField(j.location, q) * 0.5,
          scoreField(j.category, q) * 0.6
        );
        return { ...j, _score: s };
      })
      .sort((a, b) => b._score - a._score)
      .slice(0, limit);

    // Posts — also produce a snippet
    const rankedPosts = posts
      .map((p) => {
        const score = scoreField(p.text, q);
        let snippet = null;
        if (p.text) {
          const idx = p.text.toLowerCase().indexOf(q.toLowerCase());
          if (idx >= 0) {
            const start = Math.max(0, idx - 30);
            const end = Math.min(p.text.length, idx + q.length + 60);
            snippet = (start > 0 ? "…" : "") + p.text.slice(start, end) + (end < p.text.length ? "…" : "");
          }
        }
        return {
          ...p,
          hasImage: !!p.image,
          hasVideo: !!p.video,
          totalComments: Array.isArray(p.comments) ? p.comments.length : 0,
          comments: [],
          _score: score,
          _snippet: snippet,
        };
      })
      .sort((a, b) => b._score - a._score)
      .slice(0, limit);

    res.json({
      people: rankedPeople,
      companies: rankedCompanies,
      jobs: rankedJobs,
      posts: rankedPosts,
      channels: [],
    });
  } catch (err) {
    console.error("[SEARCH] error:", err.message);
    res.status(500).json({ message: err.message });
  }
});

export default router;
